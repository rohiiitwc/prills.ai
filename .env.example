# Database (Uses SQLite locally out of the box, or PostgreSQL via Docker)
DATABASE_URL=sqlite+aiosqlite:///./data/signals.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://prills_user:prills_secure_password@localhost:5432/prills_signals

# Display Timezone & Entry Time Conversion (IST = Telegram trade time + 8 hours + 30 minutes)
DISPLAY_TIMEZONE=Asia/Kolkata
ENTRY_TIME_OFFSET_HOURS=8
ENTRY_TIME_OFFSET_MINUTES=30

# Telegram API Credentials (Obtain from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=
TELEGRAM_SESSION_STRING=

# Channel Sources (Strictly Separated)
SOURCE_1_NAME=QUOTEX OFFICIAL VIP BOT
SOURCE_1_LINK=https://t.me/quotexofficialvipbot
SOURCE_1_USERNAME=quotexofficialvipbot
SOURCE_1_CATEGORY=LIVE

SOURCE_2_NAME=Quotex Vip Bot Signal
SOURCE_2_LINK=https://t.me/quotex0o
SOURCE_2_USERNAME=quotex0o
SOURCE_2_CATEGORY=OTC

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
