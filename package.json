{
  "name": "prills-ai",
  "version": "1.0.0",
  "private": true,
  "description": "PRILLS.AI Real-Time Telegram Binary Trading Signal Intelligence Website",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend,sync\" -c \"cyan,magenta,green\" \"python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --reload\" \"npm run dev --prefix frontend\" \"python auto_sync.py\"",
    "sync": "python auto_sync.py",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --reload",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "frontend": "npm run dev --prefix frontend",
    "backend": "python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --reload",
    "seed": "python backend/reset_and_seed.py",
    "test": "python -m pytest backend/tests -v",
    "lint": "npm run lint --prefix frontend"
  },
  "workspaces": [
    "frontend"
  ],
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "postcss": "^8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
